{
  "name": "nt-track",
  "version": "7.1.0",
  "description": "",
  "source": "src/index.js",
  "main": "dist/index.js",
  "bundle": "dist/index.js",
  "files": [
    "dist"
  ],
  "targets": {
    "main": false,
    "bundle": {
      "context": "browser",
      "engines": {
        "browsers": [
          "> 0.25%",
          "not dead",
          "IE 11"
        ]
      },
      "includeNodeModules": true,
      "optimize": true,
      "outputFormat": "commonjs",
      "scopeHoist": false,
      "sourceMap": false
    }
  },
  "scripts": {
    "dev": "parcel watch --target bundle --no-hmr --no-cache",
    "build": "parcel build --target bundle --no-cache && node scripts/version-parcel-runtime.js dist/index.js",
    "release": "npm version",
    "preversion": "node scripts/check-release.js",
    "version": "yarn build && git add dist/index.js",
    "postversion": "git push origin HEAD --follow-tags"
  },
  "author": "Teaching.com",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "deep-get-set": "^1.1.0",
    "howler": "^2.2.0",
    "nt-animator": "https://github.com/teachingcom/nt-animator",
    "parcel": "^2.16.4",
    "promise.allsettled": "^1.0.5",
    "random-seed": "^0.3.0",
    "url": "^0.11.4"
  }
}
